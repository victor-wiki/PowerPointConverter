<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>victor-wiki.$(AssemblyName)</PackageId>
    <Version>1.0.0</Version>
    <Authors>victor-wiki</Authors>
    <Description>Convert PowerPoint to HTML</Description>
    <RepositoryUrl>https://github.com/victor-wiki/PowerPointConverter</RepositoryUrl>
    <PackageReleaseNotes>first release</PackageReleaseNotes>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Title>victor-wiki/PowerPointConverter</Title>
    <Product>victor-wiki.$(AssemblyName)</Product>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerPointConverter\PowerPointConverter.csproj" />
  </ItemGroup>

</Project>